# =============================================================================
# Noblen AI Platform — Environment Configuration (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# All secrets are injected via environment variables — none are hard-coded.
# =============================================================================

# ---- Core application ----
ENVIRONMENT=development                 # development | staging | production
DEBUG=true
PROJECT_NAME=Noblen AI Platform
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins (no trailing slash)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Security / auth ----
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# Argon2 is used for password hashing (no plaintext passwords, ever)

# ---- Database (PostgreSQL) ----
# Async SQLAlchemy DSN. Use the +asyncpg driver.
DATABASE_URL=postgresql+asyncpg://noblen:noblen@postgres:5432/noblen
# Individual parts (used by docker-compose for the postgres service)
POSTGRES_USER=noblen
POSTGRES_PASSWORD=noblen
POSTGRES_DB=noblen

# ---- Cache / queue (Redis) ----
REDIS_URL=redis://redis:6379/0

# ---- AI Core (Phase 2) ----
# Provider secrets — BACKEND ONLY. Never expose these to the frontend / browser.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Default provider/model selection (models are configured, never hard-coded).
AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MODEL=claude-sonnet-4-5
AI_DEFAULT_EMBEDDING_PROVIDER=openai
AI_DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Resilience.
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_SECONDS=0.5

# Per-organization AI rate limiting (safe platform default; per-plan later).
AI_RATE_LIMIT_REQUESTS=60
AI_RATE_LIMIT_WINDOW_SECONDS=60

# Privacy: keep prompt/response content out of logs & the DB unless explicitly on.
AI_LOG_PROMPTS=false

# Optional JSON override for the model-pricing registry (estimates only).
# AI_PRICING_OVERRIDES_JSON={"openai:gpt-4o-mini":{"input_per_million":0.15,"output_per_million":0.6}}

# ---- Knowledge + RAG (Phase 4) ----
# pgvector is the single production vector store; the embedding dimension is fixed
# platform-wide and must match the configured embedding model.
KNOWLEDGE_EMBEDDING_PROVIDER=openai
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_EMBEDDING_DIMENSION=1536
# Ingestion limits (guard memory + cost).
MAX_DOCUMENT_SIZE_MB=20
MAX_DOCUMENT_TEXT_LENGTH=2000000
MAX_CHUNKS_PER_DOCUMENT=1000
# Chunking (character-based, paragraph-aware).
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=150
# Retrieval defaults/limits.
KNOWLEDGE_DEFAULT_TOP_K=5
KNOWLEDGE_MAX_TOP_K=20
KNOWLEDGE_DEFAULT_SIMILARITY_THRESHOLD=0.0
# Local document storage root (dev/test); swap for object storage in production.
KNOWLEDGE_STORAGE_DIR=./storage/knowledge
# Privacy: never log document content by default.
KNOWLEDGE_LOG_CONTENT=false
# Postgres+pgvector DSN used ONLY by the Knowledge/RAG test suite (skips if unset/unreachable).
# KNOWLEDGE_TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/noblen_test

# ---- Payments — Paystack (Phase 7) ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---- Google (Calendar / OAuth) (Phase 7) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- WhatsApp Cloud API (Phase 7) ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ---- Email / SMTP ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@noblenai.com
SMTP_FROM_NAME=Noblen AI

# ---- Localisation defaults (configurable per organization) ----
DEFAULT_CURRENCY=NGN
DEFAULT_TIMEZONE=Africa/Lagos
DEFAULT_LOCALE=en

# ---- Frontend (Next.js) ----
# Only NEXT_PUBLIC_* values are exposed to the browser. Never put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
